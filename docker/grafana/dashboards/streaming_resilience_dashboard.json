      },
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 1},
      "id": 2,
      "title": "Streaming Ingestion Rate (msg/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(streaming_events_total[30s])) by (symbol)",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 15}
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 1},
      "id": 3,
      "title": "Watermark Bounded Lag",
      "type": "gauge",
      "targets": [
