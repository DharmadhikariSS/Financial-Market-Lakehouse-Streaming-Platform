# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local overrides: cp .env.example .env
# ==============================================================================

# Target Database Engine: 'duckdb' (zero-RAM/local) or 'postgres' (Docker)
DB_ENGINE=duckdb

# DuckDB Settings (Used when DB_ENGINE=duckdb)
DUCKDB_PATH=data/market_ledger.duckdb

# PostgreSQL Settings (Used when DB_ENGINE=postgres or via Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# Pipeline Tuning
BATCH_SIZE=25000
LOG_LEVEL=INFO

# S3 / MinIO Settings (Reserved for Milestone 03 & 04)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=market-lakehouse
